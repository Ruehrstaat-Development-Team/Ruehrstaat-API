# Runtime
GIN_MODE=debug
CRON=false

# Feature flags
REGISTRATION_DISABLED=true
DB_AUTOMIGRATE=true
# Supported startup modes:
# - DB_AUTOMIGRATE=false and DB_RUN_TRACKED_MIGRATIONS=false: skip startup migrations, but startup now fails if the required auth/session schema is still missing.
# - DB_AUTOMIGRATE=true: run AutoMigrate and tracked migrations.
# - DB_AUTOMIGRATE=false and DB_RUN_TRACKED_MIGRATIONS=true: run tracked migrations only; use this after the base tables already exist or startup will stop on schema validation.
DB_RUN_TRACKED_MIGRATIONS=false
SMTP_DISABLED=true
MORIA_ENABLED=false

# Observability
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENV=localdevelopment
# Shared for traces and error event sampling. Default is 1.0 when unset.
SENTRY_SAMPLING_RATE=1.0
# Optional path for newline-delimited JSON security audit logs. Defaults to security_audit.log.
SECURITY_AUDIT_LOG_PATH=security_audit.log

# Database
DB_HOST=localhost
DB_PORT=15433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=15434
REDIS_PASS=postgres

# Auth and encryption
# Required. Generate your own 32+ character secret for identity/access JWT signing.
JWT_IDENTITY_SECRET=replace-with-your-own-32-plus-character-secret
# Required. Generate your own 16+ character secret for refresh JWT signing.
JWT_REFRESH_SECRET=replace-with-your-own-16-plus-character-secret
# Required to enable TOTP on new and existing encrypted data. Use 32 raw characters or base64 for 16/24/32 bytes.
OTP_ENC_KEY=replace-with-your-own-32-char-or-base64-aes-key
# Required to enable FIDO2 on new and existing encrypted data. Use 32 raw characters or base64 for 16/24/32 bytes.
FIDO_ENC_KEY=replace-with-your-own-32-char-or-base64-aes-key

# SMTP
SMTP_FROM=Ruehrstaat Squadron <web@ruehrstaat.org>
SMTP_HOST=SERVER
SMTP_PORT=587
SMTP_USER=USER
SMTP_PASS=PASSWORD

# Frontend and CORS
# Single literal origin, comma-separated origins, or `*`.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FQDN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Comma-separated proxy IPs or CIDRs allowed to supply forwarded client/proto headers. Leave empty to trust none.
TRUSTED_PROXIES=
# Refresh cookie SameSite policy. Supported: lax (default), strict, none.
# Cookie-only browser session endpoints such as refresh/logout/logoutAll require an allowed Origin or Referer in every SameSite mode.
# Cross-site browser auth flows still need `none`, HTTPS, and concrete allowed origins in FRONTEND_URL/BACKEND_URL/CORS_ALLOWED_ORIGINS (wildcards are ignored).
# Quicklogin and passivelogin completion also require an allowed Origin or Referer because they establish a new browser session cookie.
# If TLS terminates before the app, TRUSTED_PROXIES must also be configured so the backend can recognize the request as secure.
REFRESH_COOKIE_SAMESITE=lax

# OAuth and external services
DISCORD_CLIENT_ID=CLIENT_ID
DISCORD_CLIENT_SECRET=SECRET
MORIA_URL=http://localhost:8001
MORIA_TOKEN=SECRET
